# Variables de entorno del bot de pedidos.
# Copia este archivo a `.env` y completa allí tus valores reales.
# No guardes credenciales reales en este archivo.

# Servidor backend
PORT=3001
FRONTEND_URL=http://localhost:5173
RESTAURANT_NAME=Restaurante
WHATSAPP_NUMBER=

# Google Sheets
GOOGLE_SHEET_MENU_ID=tu_id_de_hoja_menu
GOOGLE_SHEET_PEDIDOS_ID=tu_id_de_hoja_pedidos
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google-service-account.json

# Envío de comandas por correo
NOTIFICADOR=gmail
GMAIL_USER=tu_correo@gmail.com
RESTAURANT_EMAIL=correo_destino@ejemplo.com
# Usa una contraseña de aplicación nueva, no la contraseña normal de Gmail.
GMAIL_APP_PASSWORD=
